FROM golang:1.26-alpine AS go-builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/api ./cmd/api
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/seed ./cmd/seed
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/krogeringest ./cmd/krogeringest
RUN CGO_ENABLED=0 GOOS=linux go install -tags 'postgres,file' \
      github.com/golang-migrate/migrate/v4/cmd/migrate@v4.19.1 \
    && cp "$(go env GOPATH)/bin/migrate" /out/migrate

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/solver:/app/solver/gen \
    SOLVER_ADDR=127.0.0.1:50051

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.13 /uv /usr/local/bin/uv

WORKDIR /app/solver
COPY solver/pyproject.toml solver/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
ENV PATH="/app/solver/.venv/bin:$PATH"

COPY solver/gen/ ./gen/
COPY solver/lp.py solver/milp.py solver/server.py ./
COPY deploy/render_entrypoint.py /app/render_entrypoint.py
COPY --from=go-builder /out/api /usr/local/bin/api
COPY --from=go-builder /out/seed /usr/local/bin/seed
COPY --from=go-builder /out/krogeringest /usr/local/bin/krogeringest
COPY --from=go-builder /out/migrate /usr/local/bin/migrate
COPY migrations/ /migrations/

RUN useradd --create-home --uid 10001 macrocart \
    && chown -R macrocart:macrocart /app /migrations
USER macrocart

EXPOSE 10000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "/app/render_entrypoint.py"]
