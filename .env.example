# Copy to .env and add local credentials. Never commit .env.

# ---------------------------------------------------------------- server
# Port the API listens on. Must be 1-65535.
PORT=4000

# ------------------------------------------------------------ datastores
# Defaults below match docker-compose.yml. sslmode=disable is fine for
# localhost; a production DSN must require TLS.
DATABASE_URL=postgres://macrocart:macrocart@localhost:5432/macrocart?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Used only by `make test-int`. Points at the same local database here; CI
# overrides it with its own throwaway service container.
TEST_DATABASE_URL=postgres://macrocart:macrocart@localhost:5432/macrocart?sslmode=disable

# --------------------------------------------------------- external APIs
# USDA FoodData Central. Free signup:
#   https://fdc.nal.usda.gov/api-key-signup.html
# Only cmd/fdcimport needs this — the API server and all tests run without it.
FDC_API_KEY=

# Kroger developer app. Requires product.compact for ingestion and
# cart.basic:write for the user-authorized cart flow.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Product ingestion is fixed to Harris Teeter at University Place,
# 2110 S. Estes Drive, Chapel Hill (Kroger location 09700117).

# Python OR-Tools solver over gRPC.
SOLVER_ADDR=localhost:50051

# Claude API for recipe generation. Get one at https://console.anthropic.com/
#
# Optional. The frontend also requires NEXT_PUBLIC_ANTHROPIC_RECIPES=true at build time.
ANTHROPIC_API_KEY=

# Browser origin used for cart callbacks. This is intentionally required when
# Kroger credentials are set; there is no code fallback that could send a
# production callback to localhost. Register WEB_APP_URL plus
# /api/kroger/callback as the exact Kroger redirect URI.
WEB_APP_URL=http://localhost:3000

# Frontend build flag; use true only when ANTHROPIC_API_KEY is configured.
NEXT_PUBLIC_ANTHROPIC_RECIPES=false

# Expose the cart action only when Kroger credentials and WEB_APP_URL are set.
NEXT_PUBLIC_KROGER_CART=false
