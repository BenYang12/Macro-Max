# Copy this file to .env and fill in real values:
#
#     cp .env.example .env
#
# .env is gitignored (real secrets live there); THIS file is committed as the
# documentation of every knob the app has. Keep them in sync: when you add a
# variable to internal/config, add it here too with a safe placeholder.
#
# The Makefile does `-include .env` + `export`, so `make run`, `make seed`, and
# `make test-int` all see these automatically. That's why the Go code needs no
# dotenv library.

# ---------------------------------------------------------------- server
# Port the API listens on. Must be 1-65535.
PORT=4000

# ------------------------------------------------------------ datastores
# Defaults below match docker-compose.yml. sslmode=disable is fine for
# localhost; a production DSN must require TLS.
DATABASE_URL=postgres://macrocart:macrocart@localhost:5432/macrocart?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Used only by `make test-int`. Points at the same local database here; CI
# overrides it with its own throwaway service container.
TEST_DATABASE_URL=postgres://macrocart:macrocart@localhost:5432/macrocart?sslmode=disable

# --------------------------------------------------------- external APIs
# USDA FoodData Central (Phase 2). Free, instant signup:
#   https://fdc.nal.usda.gov/api-key-signup.html
# Only cmd/fdcimport needs this — the API server and all tests run without it.
FDC_API_KEY=

# Kroger developer app (Phase 5). Needs the product.compact scope for product
# search and prices. Register at https://developer.kroger.com/
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Zip code for store lookup. 27514 is Chapel Hill, NC — my campus area, where
# the nearby stores are Harris Teeter.
#
# WORTH KNOWING: Harris Teeter is a Kroger SUBSIDIARY, not a Kroger-branded
# store. Kroger's API covers its family of banners, and Harris Teeter is
# normally one of them — but "owned by Kroger" and "exposed through the Kroger
# API with prices" are two different claims, and only the first is documented.
# `make kroger-stores` is the check: if HT locationIds come back, I'm fine. If
# only distant Kroger-branded stores appear, my options are to solve against a
# further store or to keep using SEED prices for the demo.
KROGER_ZIP=27514

# The store to ingest prices from. Find it once with:
#   make kroger-stores
# then paste the locationId here.
#
# VERIFIED 2026-07-31: Harris Teeter DOES resolve through the Kroger API
# (chain code "HART"), and product search returns real prices for it. That was
# the open Step-0 question in my plan, and it's now answered.
# 09700223 is Harris Teeter Chapel Hill North, 1800 MLK Jr Blvd.
KROGER_LOCATION_ID=09700223

# Python OR-Tools solver over gRPC (Phase 3).
SOLVER_ADDR=localhost:50051

# Claude API for recipe generation (Phase 7).
ANTHROPIC_API_KEY=
