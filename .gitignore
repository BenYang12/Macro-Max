# Local planning notes — not part of the published repo
docs/PLAN.md
.claude


# Local environment variables (real secrets live here; .env.example is committed)
.env
.venv


#my .pyc files -> only reson these are added is because they are build artifcats and will produce noisy diffs forever
solver/__pycache__/lp.cpython-313.pyc
solver/gen/__pycache__/__init__.cpython-313.pyc


# Python build artifacts. Compiled bytecode is machine- and version-specific
# (note the "cpython-313" in the filenames), so committing it means noisy diffs
# forever and zero benefit — Python regenerates these on every import.
__pycache__/
*.py[cod]

# uv's virtualenv. The LOCKFILE (solver/uv.lock) IS committed, because that's
# what makes installs reproducible; the venv it produces is derived data.
.venv/

# Editable-install metadata, generated by `uv pip install -e .`. Same category
# as __pycache__: derived from pyproject.toml, regenerated on every install, and
# it churns constantly. The lockfile (solver/uv.lock) is what actually pins
# things and stays committed.
*.egg-info/

# Node / Next.js (Phase 6 frontend). This repo has already leaked __pycache__
# and egg-info once each; adding these BEFORE the first npm install rather than
# after is the cheaper order.
node_modules/
.next/
next-env.d.ts
web/tsconfig.tsbuildinfo
web/playwright-report/
web/test-results/
